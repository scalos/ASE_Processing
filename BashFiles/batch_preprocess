					-dfile ${boldrun}_mc_${x}.1D -prefix ${boldrun}_reg_${x}.nii.gz ${boldrun}_${x}.nii.gz
				echo motioncorrect $boldrun done `date +%Y%m%d` `date +%T`
			endif
		end
    #endif
endif

