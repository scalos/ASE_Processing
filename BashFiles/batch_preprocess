##### Register ase_base to brain

if ($DOregisterase == 1) then
    cd $direc/session_ase 
	3dAFNItoNIFTI -prefix anat_fs_brain_al.nii.gz ../session_afni_nortc/anat_fs_brain_al+orig
	3dAFNItoNIFTI -prefix anat_fs_brain_al_mask.nii.gz ../session_afni_nortc/anat_fs_brain_al_mask+orig
	3dAFNItoNIFTI -prefix anat_fs_xvent_mask_al.nii.gz ../session_afni_nortc/anat_fs_xvent_mask_al+orig
	if !(-e $direc/aparc_mask/LR_Cerebral_GM_mask.nii.gz) then
		3dcalc -a $direc/aparc_mask/L_Cerebral_GM_mask+orig -b $direc/aparc_mask/R_Cerebral_GM_mask+orig -expr 'step(a+b)' -prefix $direc/aparc_mask/LR_Cerebral_GM_mask.nii.gz
		3dcalc -a $direc/aparc_mask/L_Cerebral_WM_mask+orig -b $direc/aparc_mask/R_Cerebral_WM_mask+orig -expr 'step(a+b)' -prefix $direc/aparc_mask/LR_Cerebral_WM_mask.nii.gz	
	endif
	cp $direc/aparc_mask/LR_Cerebral_GM_mask.nii.gz .
	cp $direc/aparc_mask/LR_Cerebral_WM_mask.nii.gz .
	
    if !(-e ase_base_al.nii.gz) then
    	3dAllineate -prefix ase_base_al.nii.gz -base anat_fs_brain_al.nii.gz -master anat_fs_brain_al.nii.gz \
			-source ase_base.nii.gz -twopass -cost lpa+ -1Dmatrix_save ase_base_al_mat.aff12.1D -autoweight -fineblur 1 -cmass
    endif
    #3dAllineate -1Dmatrix_apply ase_base_al_mat.aff12.1D -master anat_fs_brain_al.nii.gz -prefix ${boldrun}_blur_al.nii.gz ${boldrun}_blur.nii.gz     
endif  

##### Calculate mean across repetitions

if ($DOmean == 1) then
    cd $direc/session_ase	
	3dMean -prefix ${boldrun}_reg_mean.nii.gz ${boldrun}_reg_r1.nii.gz ${boldrun}_reg_r2.nii.gz
endif

##### Increase SNR by resampling and smoothing

if ($DOSNR == 1) then
    cd $direc/session_ase	
	3dresample -dxyz 4.0 4.0 8.0 -input ${boldrun}_reg_mean.nii.gz -prefix ${boldrun}_resamp.nii.gz
	if !(-e ase_mask.nii.gz) then
		cat_matvec ase_base_al_mat.aff12.1D -I > ase_base_al_inv_mat.aff12.1D
		3dAllineate -1Dmatrix_apply ase_base_al_inv_mat.aff12.1D -interp NN -final NN \
			-master ase_base.nii.gz -prefix ase_mask.nii.gz  -input anat_fs_xvent_mask_al.nii.gz
	endif
	#3dmerge -1blur_fwhm 3.0 -doall -prefix ${boldrun}_blur.nii.gz ${boldrun}_resamp.nii.gz		
	3dBlurInMask -mask ase_mask.nii -FWHM $boldblur -prefix ${boldrun}_blur.nii.gz ${boldrun}_resamp.nii.gz
endif

