##### Convert masks to session_ase

if ($DOconvertmask == 1) then
    cd $direc/session_ase
    3dAFNItoNIFTI -prefix anat_fs_brain_al.nii.gz $direc/session_afni_nortc/anat_fs_brain_al+orig
    3dAFNItoNIFTI -prefix anat_fs_brain_al_mask.nii.gz $direc/session_afni_nortc/anat_fs_brain_al_mask+orig
    3dAFNItoNIFTI -prefix anat_fs_xvent_mask_al.nii.gz $direc/session_afni_nortc/anat_fs_xvent_mask_al+orig
    3dcalc -a $direc/aparc_mask/L_Cerebral_GM_mask+orig -b $direc/aparc_mask/R_Cerebral_GM_mask+orig -expr 'step(a+b)' -prefix LR_Cerebral_GM_mask.nii.gz
    3dcalc -a $direc/aparc_mask/L_Cerebral_WM_mask+orig -b $direc/aparc_mask/R_Cerebral_WM_mask+orig -expr 'step(a+b)' -prefix LR_Cerebral_WM_mask.nii.gz
