##### SET YOUR VARIABLES HERE
# stop at 'wait' to check the data and parameters before proceeding to the next step

set boldblur           = 3          # FWHM  e.g. 3 for normalization
#set boldmccensor       = 0.4        # extent of motion to be censored (previous, 0.3)
#set boldoutcount       = 0.05        # fraction of voxels considered as outliers e.g. DOcensor 0.1

