	if !(-e ${boldrun}_tshift.nii.gz) then
	    if (-e $direc/nii/${boldrun}_tpattern.1D) then
			cp $direc/nii/${boldrun}_tpattern.1D tpattern.1D	    
	    	3dTshift -tzero 0 -tpattern @tpattern.1D -prefix ${boldrun}_tshift.nii.gz ${boldrun}.nii
	    	rm tpattern.1D	  
	    else  
	    	if (-e $direc/nii/${boldrun}.json) then
	    		jq -r '.SliceTiming' $direc/nii/${boldrun}.json | sed -e '/\[/d' -e '/\]/d' -e 's/,//g' > tpattern.1D
	    		3dTshift -tzero 0 -tpattern @tpattern.1D -prefix ${boldrun}_tshift.nii.gz ${boldrun}.nii
	    		mv tpattern.1D ${boldrun}_tpattern.1D
	    	else
	    		3dAttribute TAXIS_OFFSETS ${boldrun}.nii > tmp.1D
	    		1dtranspose tmp.1D > tpattern.1D
				3dTshift -tzero 0 -tpattern @tpattern.1D -prefix ${boldrun}_tshift.nii.gz ${boldrun}.nii
				mv tpattern.1D ${boldrun}_tpattern.1D
	    		rm tmp.1D
	    	endif
	    endif
	    echo tshift $boldrun done `date +%Y%m%d` `date +%T`
	endif	
endif

##### READ IMAGE COMMENTS

if ($DOrecondata_xdespiketshift == 1) then	
	cd $direc
	if !(-e session_ase) then
		mkdir session_ase
	endif
	cd $direc/session_ase
	Siemens_ase_XA30 $direc/nii/$paranb $direc/dcm.index.out ${paranb} 3
	
	set DTE = `awk '{print $4}' dcm_hdr_${paranb} | sed 's/_/ /g' | awk '{print $2}' | sed -e 's/DTE=//g' -e 's/us//g'`
	#set T = `echo $DTE | awk '{for(i=1;i<=NF;i++) print 44000-$i}'`
	set T = `echo $DTE | awk '{for(i=1;i<=NF;i++) print $i}'`
	set T_indx = ( `echo "$T" | awk '{for(i=1;i<=NF;i++) print $i, i}' | sort -n -k1 -k2 | awk '{print $2 - 1}'` )
	set r1 = ( `echo "$T_indx" | awk '{for(i=1; i<=NF; i+=2) print $i}' | sed 's/ /,/g'` )
	set r2 = ( `echo "$T_indx" | awk '{for(i=2; i<=NF; i+=2) print $i}' | sed 's/ /,/g'` )
	set r1_tmp = `echo $r1 | sed 's/ /,/g'`
	set r2_tmp = `echo $r2 | sed 's/ /,/g'`
	3dcalc -a "${boldrun}.nii[$r1_tmp]" -expr a -prefix ${boldrun}_r1.nii.gz
	3dcalc -a "${boldrun}.nii[$r2_tmp]" -expr a -prefix ${boldrun}_r2.nii.gz
endif

