if ($DOboldread == 1) then
	cd $direc
	if !(-e session_ase) then
		mkdir session_ase
	endif
    cd $direc/session_ase
    if !(-e ${boldrun}.nii) then
    	if !(-e $direc/nii/${boldrun}.nii) then
    		if (-e $direc/nii/${paranb}) then
    			cd $direc/nii
				set Nf = `ls -ld $direc/nii/${paranb}/MR.* | wc -l`
				if (`echo "$Nf > 500" | bc`) then
					dcm2niix_afni -f ${boldrun} -o $direc/nii $direc/nii/${paranb}
				else
					Dimon -infile_pattern "./${paranb}/MR.*" -gert_create_dataset -gert_to3d_prefix ${boldrun}.nii
    			endif
    			#jq -r '.SliceTiming' ${boldrun}.json | sed -e '/\[/d' -e '/\]/d' -e 's/,//g'  			
    		endif
    	endif
		cp $direc/nii/${boldrun}.nii $direc/session_ase/
	endif
	#if (-e $direc/nii/${boldrun}.nii) then
	#	if (-e $direc/nii/${paranb}) then
	#		rm -rf $direc/nii/${paranb}
	#	endif
	#endif
	cd $direc/session_ase
	if (-e ${boldrun}.nii) then
		set deobltmp = `3dinfo ${boldrun}.nii | grep 'Data Axes Tilt:' | sed -e 's/Data Axes Tilt: //g' -e 's/\([A-Z][a-z]*\).*/\1/'`	
		if ($deobltmp == Oblique) then
			3drefit -deoblique ${boldrun}.nii
			echo readdeobl $boldrun done `date +%Y%m%d` `date +%T`
		endif	
		echo read $boldrun done `date +%Y%m%d` `date +%T`
    endif
endif

