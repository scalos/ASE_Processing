set DOboldread                  = 0     # 
set DOdespike                   = 0     # caution for the last 8 volumes; skip it
set DOtshift                    = 0     # caution for artifact on time series
set DOrecondata_xdespiketshift	= 0		# 
set DOmotion                    = 0     # 

set DOcensor                    = 0     # do NOT use censoring at the moment
set DOconvertmask				= 0		#
set DOregisterase				= 0		#
set DOmean						= 0		#
set DOSNR						= 0		#


##### GET THE PATH AND INITIALS OF THE SUBJECT

set curdir = `pwd`

##### GET THE PATH AND INITIALS OF THE SUBJECT FROM ARG
set subjinit = $1
set boldrun = `echo $2 | sed 's/.nii//g'`
set paranb = $3
set direc = $curdir/analyzed/$subjinit
set direc_fs = $curdir/o2co2_inflated

##### DOUBLE-CHECK THE PATHS

echo The INITIALS of subject is $subjinit
echo The PATH of subject is $direc
echo The PATH of inflated directory is $direc_fs

setenv SUBJECTS_DIR $direc_fs
    
##### MAKE SESSION

cd $direc
if !(-e session_ase) then
    mkdir session_ase
endif

cd $direc/session_ase
echo the AFNI session is $direc/session_ase
